<properties xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <block name="blocks" default-type="image">

        <types>
            <type name="image">
                <meta>
                    <title>sulu_news.component.image</title>
                </meta>

                <properties>

                    <section name="customization">
                        <meta>
                            <title>sulu_news.customization_section</title>
                        </meta>
                        <properties>

                            <xi:include href="../customization.xml"
                                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)
                            xpointer(/sulu:properties/sulu:property)" />


                            <property name="cover" type="checkbox" multilingual="false" colspan="6">
                                <meta>
                                    <info_text>sulu_news.component.image.cover_info</info_text>
                                </meta>
                                <params>
                                    <param name="default_value" value="false" />
                                    <param name="type" value="toggler" />
                                    <param name="label">
                                        <meta>
                                            <title>sulu_news.component.image.cover</title>
                                        </meta>
                                    </param>
                                </params>
                            </property>

                            <property name="lightbox" type="checkbox" multilingual="false" colspan="6">
                                <params>
                                    <param name="default_value" value="true" />
                                    <param name="type" value="toggler" />
                                    <param name="label">
                                        <meta>
                                            <title>sulu_news.component.image.lightbox</title>
                                        </meta>
                                    </param>
                                </params>
                            </property>

                            <property name="fixedWidth" type="text_line" multilingual="false">
                                <meta>
                                    <title>sulu_news.component.image.fixed_width</title>
                                    <info_text>sulu_utils.fixed_width_info</info_text>
                                </meta>
                            </property>
                        </properties>
                    </section>

                    <section name="content">
                        <meta>
                            <title>sulu_page.content</title>
                        </meta>
                        <properties>
                            <property name="image" type="single_media_selection">
                                <meta>
                                    <title>sulu_content.image</title>
                                </meta>
                                    <params>
                                    <param name="displayOptions" type="collection">
                                        <param name="leftTop" value="true" />
                                        <param name="top" value="true" />
                                        <param name="rightTop" value="true" />
                                        <param name="left" value="true" />
                                        <param name="middle" value="true" />
                                        <param name="right" value="true" />
                                        <param name="leftBottom" value="true" />
                                        <param name="bottom" value="true" />
                                        <param name="rightBottom" value="true" />
                                    </param>

                                    <param name="defaultDisplayOption"
                                        value="middle" />
                                    <param name="types" value="image" />
                                </params>
                            </property>

                        </properties>
                    </section>

                </properties>
            </type>
        </types>
    </block>
</properties>